# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
fastfetch


# BEGIN opam configuration
# This is useful if you're using opam as it adds:
#   - the correct directories to the PATH
#   - auto-completion for the opam binary
# This section can be safely removed at any time if needed.
test -r '/home/aergin/.opam/opam-init/init.sh' && . '/home/aergin/.opam/opam-init/init.sh' > /dev/null 2> /dev/null || true
# END opam configuration


cp_start() {
    if [ -z "$1" ]; then
        echo "Error: Please provide a problem name (e.g., cp_start 4A)"
        return 1
    fi

    local PROBLEM=$(echo "$1" | tr '[:lower:]' '[:upper:]')
    local FILENAME="${PROBLEM}.cpp"
    local TEMPLATE_PATH="../template.cpp"

    if [ ! -f "$TEMPLATE_PATH" ]; then
        echo "Error: Global template not found at $TEMPLATE_PATH"
        return 1
    fi

    if [ -f "$FILENAME" ]; then
        echo "Warning: $FILENAME already exists! Opening it instead."
    else
        # Copy the template and create a blank scratchpad for your manual inputs
        cp "$TEMPLATE_PATH" "$FILENAME"
        echo "Created $FILENAME and in.txt successfully."
    fi

    vim "$FILENAME"
}

alias cps=cp_start

export EDITOR=vim
export VISUAL=vim
